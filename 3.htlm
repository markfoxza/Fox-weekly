<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fox Family — Week 9-15 Mar 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Source+Sans+3:wght@300;400;500;600;700&family=Caveat:wght@500;700&display=swap" rel="stylesheet">
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Source Sans 3',sans-serif;background:#F7F5F0;color:#1A1A2E;line-height:1.5;padding:16px}
  .nav{position:sticky;top:0;z-index:100;background:rgba(247,245,240,0.92);backdrop-filter:blur(8px);padding:10px 0;display:flex;justify-content:center;gap:6px;border-bottom:1px solid rgba(0,0,0,0.06)}
  .nav a{text-decoration:none;font-size:11px;font-weight:600;padding:6px 14px;border-radius:20px;color:#666;transition:all 0.2s}
  .nav a:hover,.nav a.active{background:#1A1A2E;color:#fff}
  .nav a.sun{background:#EDE9FE;color:#6D28D9}.nav a.sun:hover{background:#6D28D9;color:#fff}
  .card{max-width:540px;margin:20px auto;background:#FFFDF8;border-radius:24px;overflow:hidden;box-shadow:0 6px 30px rgba(26,26,46,0.07)}
  .hdr{padding:24px 28px 18px;position:relative;overflow:hidden}
  .hdr::after{content:'';position:absolute;top:-30px;right:-20px;width:120px;height:120px;background:radial-gradient(circle,rgba(255,255,255,0.07) 0%,transparent 70%);border-radius:50%}
  .hdr .dl{font-family:'Caveat',cursive;font-size:15px;color:rgba(255,255,255,0.5);letter-spacing:2px;text-transform:uppercase}
  .hdr .dt{font-family:'Playfair Display',serif;font-size:32px;font-weight:800;color:#fff;line-height:1.1;margin:2px 0 6px}
  .hdr .ds{font-size:12.5px;color:rgba(255,255,255,0.5);font-weight:300;line-height:1.4}
  .hdr.mon{background:linear-gradient(135deg,#1A1A2E,#2D2B55,#3D2B6B)}
  .hdr.tue{background:linear-gradient(135deg,#1B4332,#2D6A4F,#40916C)}
  .hdr.wed{background:linear-gradient(135deg,#831843,#9D174D,#BE185D)}
  .hdr.thu{background:linear-gradient(135deg,#1E3A5F,#1E40AF,#3B82F6)}
  .hdr.fri{background:linear-gradient(135deg,#7C2D12,#C2410C,#EA580C)}
  .hdr.sat{background:linear-gradient(135deg,#3B0764,#6D28D9,#8B5CF6)}
  .hdr.sun{background:linear-gradient(135deg,#065F46,#059669,#34D399)}
  .body{padding:20px 24px 16px}
  .blk{margin-bottom:14px;border-radius:14px;padding:14px 16px 12px;position:relative}
  .blk::before{content:'';position:absolute;left:0;top:10px;bottom:10px;width:4px;border-radius:4px}
  .blk.luke{background:#FFF7F0}.blk.luke::before{background:#E8712A}
  .blk.emma{background:#F0F5FC}.blk.emma::before{background:#3B7DD8}
  .blk.gracie{background:#F0FAF2}.blk.gracie::before{background:#2EA355}
  .blk.family{background:#F4F0FF}.blk.family::before{background:#8B5CF6}
  .bh{display:flex;align-items:center;gap:7px;margin-bottom:6px;flex-wrap:wrap}
  .bi{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
  .blk.luke .bi{background:#E8712A}.blk.emma .bi{background:#3B7DD8}.blk.gracie .bi{background:#2EA355}.blk.family .bi{background:#8B5CF6}
  .bn{font-weight:700;font-size:14px}
  .blk.luke .bn{color:#C45A1A}.blk.emma .bn{color:#2A5FA8}.blk.gracie .bn{color:#1E7A3D}.blk.family .bn{color:#6D28D9}
  .bg{font-size:10px;font-weight:500;opacity:.5}
  .tg{display:inline-block;font-size:8.5px;font-weight:700;padding:2px 7px;border-radius:16px;text-transform:uppercase;letter-spacing:.4px;margin-left:3px}
  .tg.travel{background:#ECFDF5;color:#065F46}.tg.sport{background:#E0F2FE;color:#0369A1}.tg.test{background:#FEF3C7;color:#92400E}
  .tg.social{background:#FCE7F3;color:#9D174D}.tg.weekly{background:#F3F4F6;color:#374151}.tg.admin{background:#EDE9FE;color:#6D28D9}
  .it{font-size:12.5px;color:#555;padding:2px 0 2px 11px;position:relative;line-height:1.4}
  .it::before{content:'';position:absolute;left:0;top:9px;width:4px;height:4px;border-radius:50%;background:#ccc}
  .it strong{color:#1A1A2E}
  .it .tm{font-weight:700;color:#1A1A2E;font-size:11.5px}
  .rec{font-size:11.5px;color:#6B7280;padding:5px 0 1px 11px;border-top:1px dashed #E5E7EB;margin-top:5px;position:relative}
  .rec::before{content:'↻';position:absolute;left:-3px;top:5px;font-size:10px;color:#9CA3AF}
  .rbox{margin:14px 0 12px;border-radius:12px;padding:12px 16px}
  .rbox.red{background:#FEF2F2;border:1.5px solid #FECACA}.rbox.red .lb{color:#DC2626}.rbox.red li{color:#991B1B}
  .rbox.yel{background:linear-gradient(135deg,#FFFBEB,#FEF9E7);border:1.5px solid #FDE68A}.rbox.yel .lb{color:#D97706}.rbox.yel li{color:#78350F}
  .rbox.pur{background:#F3EEFF;border:1.5px solid #DDD0FA}.rbox.pur .lb{color:#6D28D9}.rbox.pur li{color:#4C1D95}
  .rbox .lb{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;margin-bottom:5px}
  .rbox li{font-size:12px;margin:3px 0 3px 16px;line-height:1.4}
  .ft{text-align:center;padding:8px 0 14px;font-size:9.5px;color:#bbb;letter-spacing:1px}
  @media print{body{background:#fff;padding:0}.card{box-shadow:none;page-break-inside:avoid;margin:10px auto}.nav{display:none}.card{page-break-after:always}}
</style>
</head>
<body>
<div class="nav">
  <a href="#mon">Mon</a><a href="#tue">Tue</a><a href="#wed">Wed</a><a href="#thu">Thu</a><a href="#fri">Fri</a><a href="#sat">Sat</a><a href="#sun" class="sun">Sun</a>
</div>

<!-- MONDAY 9 MAR -->

<div class="card" id="mon">
<div class="hdr mon"><div class="dl">Monday</div><div class="dt">9 March</div><div class="ds">Arts & Culture Week · Instrument Open Day · Hockey Trials Rd 2 · Pack for KZN!</div></div>
<div class="body">
  <div class="blk luke"><div class="bh"><div class="bi">🏑</div><div><div class="bn">Luke <span class="bg">Grade 7</span></div></div><span class="tg sport">Trials</span></div>
  <div class="it"><strong>Arts & Culture Week begins</strong> (9–13 Mar)</div>
  <div class="it"><span class="tm">15:30</span> <strong>Hockey U13 Trials Round 2</strong> — SomCol Astro (until 16:30)</div>
  <div class="rec"><span class="tg weekly">Every Mon</span> PE</div></div>

  <div class="blk emma"><div class="bh"><div class="bi">🎷</div><div><div class="bn">Emma <span class="bg">Grade 5</span></div></div></div>
