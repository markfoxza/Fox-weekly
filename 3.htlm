  <li>🧳 Ubuntu Day donations needed — diapers, Bennetts cream, wet wipes (from Tue 3 Mar)</li></ul></div>
</div>
<div class="ft">FOX FAMILY · STELLENBOSCH · WEEK OF 9 MAR 2026</div>
</div>

<script>
const cards=document.querySelectorAll('.card');const links=document.querySelectorAll('.nav a');
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.classList.remove('active'));const l=document.querySelector('.nav a[href="#'+e.target.id+'"]');if(l)l.classList.add('active');}});},{threshold:0.3});
cards.forEach(c=>obs.observe(c));
</script>

</body>
</html>